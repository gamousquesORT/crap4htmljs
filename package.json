{
  "name": "crap4htmljs",
  "version": "0.1.0",
  "description": "CRAP (Change Risk Anti-Patterns) score CLI for JavaScript, including JS embedded in HTML",
  "type": "module",
  "bin": {
    "crap4htmljs": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^5.2.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.1.4",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "parse5": "^7.2.1",
    "typescript": "^5.7.2",
    "vitest": "^3.1.4"
  }
}
